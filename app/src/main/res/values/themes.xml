<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Crystal Edition (Light)
        DESIGN.md tokens applied:
          surface:     #f9f9fb
          on-surface:  #1a1c1d
          primary:     #000000
          background:  #f9f9fb
        Glass: white 15% fill, black 10% border
    -->
    <style name="Theme.AuraOS" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Material color roles -->
        <item name="colorPrimary">@color/lrg_accent</item>
        <item name="colorOnPrimary">@color/lrg_light_on_accent</item>
        <item name="colorPrimaryContainer">@color/lrg_light_surface</item>
        <item name="colorOnPrimaryContainer">@color/lrg_light_text_primary</item>
        <item name="colorSecondary">@color/lrg_light_text_secondary</item>
        <item name="colorOnSecondary">@color/lrg_light_bg</item>
        <item name="colorSecondaryContainer">@color/lrg_light_surface</item>
        <item name="colorOnSecondaryContainer">@color/lrg_light_text_primary</item>
        <item name="colorSurface">@color/lrg_light_surface</item>
        <item name="colorOnSurface">@color/lrg_light_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/lrg_light_text_secondary</item>
        <item name="colorOutline">@color/lrg_light_border_control</item>
        <item name="colorOutlineVariant">@color/lrg_light_border</item>
        <item name="colorBackground">@color/lrg_light_bg</item>
        <item name="colorOnBackground">@color/lrg_light_text_primary</item>
        <item name="colorError">@color/crystal_error</item>
        <item name="colorOnError">@color/crystal_on_error</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Custom attrs -->
        <item name="appLogoCustom">@drawable/ic_logo_crystal_light</item>
        <item name="loginBackgroundCustom">@color/lrg_light_bg</item>
        <item name="glassCardBackgroundCustom">@drawable/bg_lrg_card</item>
        <item name="status_info">@color/status_info</item>
        <item name="textPrimaryCustom">@color/lrg_light_text_primary</item>
        <item name="textSecondaryCustom">@color/lrg_light_text_secondary</item>
        <item name="dividerColorCustom">@color/lrg_light_border</item>

        <!-- Home attrs -->
        <item name="homeSurfaceBackground">@color/lrg_light_bg</item>
        <item name="navbarBackground">@drawable/bg_lrg_top_bar</item>
        <item name="navbarBorderColor">@color/lrg_light_border</item>
        <item name="bottomNavbarBackground">@drawable/bg_lrg_bottom_bar</item>
        <item name="bottomNavbarBorderColor">@color/lrg_light_border</item>

        <!-- Input & Button drawables -->
        <item name="hollowInputBackground">@drawable/bg_lrg_input</item>
        <item name="primaryButtonBackground">@drawable/bg_lrg_primary_button</item>

        <!-- Dashboard semantic colors -->
        <item name="cardGlassFillColorCustom">@color/lrg_light_surface</item>
        <item name="semanticSuccessCustom">@color/lrg_light_accent_text</item>

        <!-- Home card outlines -->
        <item name="homeOutlineCustom">@color/lrg_light_border</item>
        <item name="bottomNavItemColorCustom">@color/lrg_light_text_secondary</item>
        <item name="photoPlaceholderTintCustom">@color/lrg_light_text_muted</item>
        <item name="videoFeedBackgroundCustom">@color/lrg_light_surface</item>
        <item name="liveBadgeBackgroundCustom">#40000000</item>
        <item name="liveBadgeTextCustom">@color/crystal_error</item>

        <item name="photoOverlayCustom">@drawable/bg_glass_photo_overlay</item>

        <!-- Branch surfaces (Crystal Edition) -->
        <item name="branchSurfaceCustom">@color/lrg_light_surface</item>
        <item name="branchProgressTrackCustom">@color/lrg_light_border</item>
        <item name="branchSurfaceTextCustom">@color/lrg_light_text_primary</item>
    
        <!-- LRGutierrez design system (BCV Tracker family) -->
        <item name="textMutedCustom">@color/lrg_light_text_muted</item>
        <item name="accentTextCustom">@color/lrg_light_accent_text</item>
        <item name="accentCustom">@color/lrg_accent</item>
        <item name="onAccentCustom">@color/lrg_light_on_accent</item>
        <item name="borderControlCustom">@color/lrg_light_border_control</item>
        <item name="android:windowBackground">@color/lrg_light_bg</item>
        <item name="android:fontFamily">@font/aura_sans</item>
        <item name="fontFamily">@font/aura_sans</item>
        <item name="android:textColorPrimary">@color/lrg_light_text_primary</item>
        <item name="android:textColorSecondary">@color/lrg_light_text_secondary</item>
        <item name="colorControlNormal">@color/lrg_light_text_secondary</item>
        <item name="colorControlActivated">@color/lrg_accent</item>
        <item name="android:colorEdgeEffect">@color/lrg_light_border</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Lrg.Control</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Lrg.Card</item>
        <item name="textAppearanceButton">@style/TextAppearance.Lrg.Button</item>
        <item name="materialButtonStyle">@style/Widget.Lrg.Button</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Pc.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Pc.Dialog</item>
    </style>

    <style name="Theme.AuraOS.NoActionBar" parent="Theme.AuraOS">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Connectivity banner -->
        <item name="connectivityOfflineCustom">@color/connectivity_offline_crystal</item>
        <item name="connectivityOnlineCustom">@color/connectivity_online_crystal</item>
    </style>

    <style name="Theme.AuraOS.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.AuraOS.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
