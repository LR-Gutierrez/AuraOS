<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Crystal Edition (Light)
        DESIGN.md tokens applied:
          surface:     #f9f9fb
          on-surface:  #1a1c1d
          primary:     #000000
          background:  #f9f9fb
        Glass: white 15% fill, black 10% border
    -->
    <style name="Theme.AuraOS" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Material color roles -->
        <item name="colorPrimary">@color/crystal_primary</item>
        <item name="colorOnPrimary">@color/crystal_on_primary</item>
        <item name="colorPrimaryContainer">@color/crystal_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/crystal_on_primary_container</item>
        <item name="colorSecondary">@color/crystal_secondary</item>
        <item name="colorOnSecondary">@color/crystal_on_secondary</item>
        <item name="colorSecondaryContainer">@color/crystal_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/crystal_on_secondary_container</item>
        <item name="colorSurface">@color/crystal_surface</item>
        <item name="colorOnSurface">@color/crystal_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/crystal_on_surface_variant</item>
        <item name="colorOutline">@color/crystal_outline</item>
        <item name="colorOutlineVariant">@color/crystal_outline_variant</item>
        <item name="colorBackground">@color/crystal_background</item>
        <item name="colorOnBackground">@color/crystal_on_background</item>
        <item name="colorError">@color/crystal_error</item>
        <item name="colorOnError">@color/crystal_on_error</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Custom attrs -->
        <item name="appLogoCustom">@drawable/ic_logo_crystal_light</item>
        <item name="loginBackgroundCustom">@drawable/login_background_light</item>
        <item name="glassCardBackgroundCustom">@drawable/bg_glass_card</item>
        <item name="status_info">@color/status_info</item>
        <item name="textPrimaryCustom">@color/crystal_on_surface</item>
        <item name="textSecondaryCustom">@color/crystal_on_surface_variant</item>
        <item name="dividerColorCustom">@color/crystal_border</item>

        <!-- Home attrs -->
        <item name="homeSurfaceBackground">@color/crystal_surface_bright</item>
        <item name="navbarBackground">@drawable/bg_top_app_bar_blur</item>
        <item name="navbarBorderColor">@color/crystal_border</item>
        <item name="bottomNavbarBackground">@drawable/bg_bottom_nav_blur</item>
        <item name="bottomNavbarBorderColor">@color/crystal_border</item>

        <!-- Input & Button drawables -->
        <item name="hollowInputBackground">@drawable/bg_hollow_input</item>
        <item name="primaryButtonBackground">@drawable/bg_primary_button</item>

        <!-- Dashboard semantic colors -->
        <item name="cardGlassFillColorCustom">@color/glass_fill_light</item>
        <item name="semanticSuccessCustom">#2E7D32</item>

        <!-- Home card outlines -->
        <item name="homeOutlineCustom">@color/crystal_surface_variant</item>
        <item name="bottomNavItemColorCustom">@color/crystal_secondary</item>
        <item name="photoPlaceholderTintCustom">@color/crystal_outline</item>
        <item name="videoFeedBackgroundCustom">@color/crystal_surface_container_high</item>
        <item name="liveBadgeBackgroundCustom">#40000000</item>
        <item name="liveBadgeTextCustom">@color/crystal_error</item>

        <item name="photoOverlayCustom">@drawable/bg_glass_photo_overlay</item>

        <!-- Branch surfaces (Crystal Edition) -->
        <item name="branchSurfaceCustom">@color/branch_surface_light</item>
        <item name="branchProgressTrackCustom">@color/branch_progress_track_light</item>
        <item name="branchSurfaceTextCustom">@color/crystal_on_surface</item>
    </style>

    <style name="Theme.AuraOS.NoActionBar" parent="Theme.AuraOS">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.AuraOS.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.AuraOS.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
