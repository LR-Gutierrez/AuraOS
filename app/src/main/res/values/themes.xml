<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AuraOS" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">#000000</item>
        <item name="colorPrimaryVariant">#F5F5F7</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#636366</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <item name="appLogoCustom">@drawable/ic_logo_crystal_light</item>
        <item name="loginBackgroundCustom">@drawable/login_background_light</item>
        <!-- AHORA USA EL DRAWABLE CON EFECTO GLASS -->
        <item name="glassCardBackgroundCustom">@drawable/bg_glass_card</item>
        <item name="status_info">@color/status_info</item>
        <item name="textPrimaryCustom">#000000</item>
        <item name="textSecondaryCustom">#636366</item>
        <item name="dividerColorCustom">#1A000000</item>

        <item name="homeSurfaceBackground">@color/crystal_background</item>
        <item name="navbarBackground">@drawable/bg_top_app_bar_blur</item>
        <item name="navbarBorderColor">@color/crystal_border</item>
        <item name="bottomNavbarBackground">@drawable/bg_bottom_nav_blur</item>
        <item name="bottomNavbarBorderColor">@color/crystal_border</item>
    </style>

    <style name="Theme.AuraOS.NoActionBar" parent="Theme.AuraOS">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.AuraOS.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.AuraOS.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>