<?xml version="1.0" encoding="utf-8"?>
<!-- Closure history row: title / total over meta / verification. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <View style="@style/Widget.Pc.Hairline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:paddingTop="14dp">

        <TextView
            android:id="@+id/tv_closure_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Pc.RowTitle"
            tools:text="14 oct · Sede Centro" />

        <TextView
            android:id="@+id/tv_closure_revenue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textAppearance="@style/TextAppearance.Pc.MonoValue"
            tools:text="$231.50" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tv_closure_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Pc.Mono"
            tools:text="19:02 · 46 salidas" />

        <TextView
            android:id="@+id/tv_closure_verified"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textAppearance="@style/TextAppearance.Pc.Mono"
            tools:text="Verificado" />
    </LinearLayout>
</LinearLayout>
