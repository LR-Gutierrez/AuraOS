<?xml version="1.0" encoding="utf-8"?>
<!--
    Kiosk entry (Parqueo·Control): type the plate, capture it, take the ticket.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/entry_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/homeSurfaceBackground"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingBottom="28dp"
    tools:context=".KioskEntryActivity">

    <TextView
        android:id="@+id/tv_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:paddingTop="8dp"
        android:textAppearance="@style/TextAppearance.Lrg.Label"
        tools:text="Autoservicio · Sede Centro" />

    <!-- Step 1 · plate -->
    <LinearLayout
        android:id="@+id/section_plate"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.Pc.TextLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pc_back_arrow"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:text="@string/pc_kiosk_entry_title"
            android:textAppearance="@style/TextAppearance.Pc.KioskTitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/pc_kiosk_entry_hint"
            android:textColor="?attr/textSecondaryCustom"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_plate_number"
            style="@style/Widget.Pc.Field"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_pc_field_large"
            android:gravity="center"
            android:hint="@string/pc_plate_hint"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:letterSpacing="0.12"
            android:maxLength="15"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/tv_plate_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.3"
            android:textColor="?attr/textPrimaryCustom"
            android:textSize="15sp"
            android:visibility="gone"
            tools:text="No pudimos registrar la entrada." />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_entry"
            style="@style/Widget.Pc.Button.Kiosk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pc_continue" />
    </LinearLayout>

    <!-- Step 2 · capture / sending -->
    <LinearLayout
        android:id="@+id/section_capture"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="300dp"
            android:layout_height="200dp"
            android:background="@drawable/bg_lrg_card">

            <ImageView
                android:id="@+id/iv_plate"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="14dp"
                android:src="@drawable/ic_pc_viewfinder"
                app:tint="?attr/accentCustom" />

            <TextView
                android:id="@+id/tv_capture_plate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_pc_plate_tag"
                android:fontFamily="@font/aura_mono"
                android:letterSpacing="0.12"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:textColor="?attr/textPrimaryCustom"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="AB123CD" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_capture_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Pc.Stat"
            android:textSize="24sp"
            tools:text="Capturando placa" />

        <TextView
            android:id="@+id/tv_capture_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="?attr/textSecondaryCustom"
            android:textSize="16sp"
            tools:text="Mantén el vehículo detenido frente a la cámara." />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/loading_overlay"
            style="@style/Widget.Pc.Progress"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Step 3 · ticket -->
    <LinearLayout
        android:id="@+id/section_ticket"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_ticket_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:text="@string/pc_kiosk_go_ahead"
            android:textAppearance="@style/TextAppearance.Pc.KioskTitle" />

        <TextView
            android:id="@+id/tv_ticket_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/pc_kiosk_ticket_hint"
            android:textColor="?attr/textSecondaryCustom"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_lrg_card"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pc_ticket"
                    android:textAppearance="@style/TextAppearance.Lrg.Label" />

                <TextView
                    android:id="@+id/tv_ticket_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Lrg.Label"
                    tools:text="T-4F2A91" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_ticket_plate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/aura_mono"
                android:letterSpacing="0.1"
                android:textColor="?attr/textPrimaryCustom"
                android:textSize="40sp"
                android:textStyle="bold"
                tools:text="AB123CD" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_pc_dashed_line"
                android:layerType="software" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="14dp">

                <TextView
                    android:id="@+id/tv_ticket_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Pc.Mono"
                    android:textColor="?attr/textSecondaryCustom"
                    android:textSize="14sp"
                    tools:text="Entrada 07:42" />

                <TextView
                    android:id="@+id/tv_ticket_branch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Pc.Mono"
                    android:textColor="?attr/textSecondaryCustom"
                    android:textSize="14sp"
                    tools:text="Sede Centro" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_done"
            style="@style/Widget.Pc.Button.KioskOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/pc_done" />
    </LinearLayout>
</LinearLayout>
