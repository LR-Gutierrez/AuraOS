<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/homeSurfaceBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="@dimen/elevation_none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_header_height"
            android:background="?attr/navbarBackground"
            android:paddingHorizontal="@dimen/spacing_large">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:background="?attr/glassCardBackgroundCustom"
                android:contentDescription="@string/action_back"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="?attr/textPrimaryCustom"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/kiosk_entry_title"
                android:textColor="?attr/textPrimaryCustom"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btn_back"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/entryScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/container_padding"
            android:paddingTop="@dimen/spacing_large"
            android:paddingBottom="@dimen/spacing_xxlarge">

            <FrameLayout
                android:id="@+id/container_member_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/glassCardBackgroundCustom"
                android:padding="@dimen/spacing_large"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_member_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_member_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/membership_entry_free"
                        android:textColor="@android:color/holo_green_dark"
                        android:textSize="@dimen/text_size_small"
                        android:textStyle="bold" />

                </LinearLayout>

            </FrameLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_plate_capture"
                android:layout_width="match_parent"
                android:layout_height="@dimen/video_feed_height"
                android:layout_marginTop="@dimen/spacing_large"
                android:backgroundTint="?attr/videoFeedBackgroundCustom"
                android:clipToOutline="true"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardElevation="@dimen/elevation_none"
                app:layout_constraintTop_toBottomOf="@id/container_member_info"
                app:strokeWidth="@dimen/stroke_none">

                <FrameLayout
                    android:id="@+id/container_plate"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/iv_plate"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_plate_photo"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_scan_corners" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_gravity="bottom"
                        android:background="?attr/photoOverlayCustom" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/plate_capture_hint"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btn_retake_plate"
                        android:layout_width="@dimen/icon_size_large"
                        android:layout_height="@dimen/icon_size_large"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:background="?attr/glassCardBackgroundCustom"
                        android:contentDescription="@string/action_retake"
                        android:elevation="2dp"
                        android:padding="4dp"
                        android:src="@drawable/ic_retake"
                        app:tint="?attr/textPrimaryCustom"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/btn_delete_plate"
                        android:layout_width="@dimen/icon_size_large"
                        android:layout_height="@dimen/icon_size_large"
                        android:layout_gravity="top|start"
                        android:layout_margin="4dp"
                        android:background="?attr/glassCardBackgroundCustom"
                        android:contentDescription="@string/action_delete"
                        android:elevation="2dp"
                        android:padding="4dp"
                        android:src="@drawable/ic_delete"
                        app:tint="?attr/textPrimaryCustom"
                        android:visibility="gone" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_plate_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_marginTop="@dimen/spacing_xsmall"
                android:fontFamily="sans-serif-medium"
                android:text="@string/required_field_error"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="@dimen/text_size_small"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/card_plate_capture"
                app:layout_constraintTop_toBottomOf="@id/card_plate_capture" />

            <FrameLayout
                android:id="@+id/container_ocr_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:background="?attr/glassCardBackgroundCustom"
                android:padding="@dimen/spacing_large"
                app:layout_constraintTop_toBottomOf="@id/card_plate_capture">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/lbl_ocr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/ocr_status_label"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_overline"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/et_plate_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:background="@android:color/transparent"
                        android:fontFamily="sans-serif-black"
                        android:hint="@string/plate_input_hint"
                        android:imeOptions="actionDone"
                        android:inputType="text|textCapCharacters"
                        android:maxLines="1"
                        android:padding="0dp"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textColorHint="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_plate"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/lbl_ocr" />

                    <TextView
                        android:id="@+id/tv_db_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:fontFamily="sans-serif"
                        android:text="@string/plate_validation_status"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/et_plate_number" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_entry"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/primary_button_height"
                android:layout_marginTop="@dimen/spacing_xxlarge"
                android:text="@string/action_confirm_entry"
                android:textAllCaps="false"
                android:textSize="@dimen/text_size_button"
                android:textStyle="bold"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="@dimen/button_corner_radius_full"
                app:layout_constraintTop_toBottomOf="@id/container_ocr_data" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="?attr/colorPrimary"
            app:indicatorSize="48dp"
            app:trackThickness="4dp" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
