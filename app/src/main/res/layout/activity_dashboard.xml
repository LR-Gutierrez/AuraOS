<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/homeSurfaceBackground"
    tools:context=".DashboardActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="@dimen/elevation_none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_header_height"
            android:background="?attr/navbarBackground"
            android:paddingHorizontal="@dimen/spacing_large"
            app:layout_scrollFlags="scroll|enterAlways">

            <TextView
                android:id="@+id/tv_app_title"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:fontFamily="sans-serif-black"
                android:gravity="bottom"
                android:text="@string/dashboard_title"
                android:textColor="?attr/textPrimaryCustom"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/tv_branch_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_branch_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_small"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-black"
                android:text="@string/branch_no_branch"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_branch_selector"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_app_title" />

            <TextView
                android:id="@+id/cached_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xsmall"
                android:text="Cached"
                android:textSize="@dimen/text_size_caption"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/tv_branch_name"
                app:layout_constraintTop_toBottomOf="@id/tv_branch_name" />

            <ImageButton
                android:id="@+id/btn_branch_selector"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:background="?attr/glassCardBackgroundCustom"
                android:contentDescription="@string/branch_select_hint"
                android:src="@android:drawable/arrow_down_float"
                app:tint="?attr/textPrimaryCustom"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="true"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/container_padding"
            android:paddingTop="@dimen/spacing_large"
            android:paddingBottom="@dimen/dashboard_scroll_padding_bottom">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_occupancy"
                android:layout_width="0dp"
                android:layout_height="200dp"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardBackgroundColor="?attr/branchSurfaceCustom"
                app:cardElevation="0dp"
                app:strokeColor="?attr/dividerColorCustom"
                app:strokeWidth="@dimen/stroke_thin"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:id="@+id/tv_capacity_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_capacity_label"
                        android:textStyle="bold"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_overline"
                        android:letterSpacing="0.05"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/tv_occupancy_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_occupancy_title"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        app:layout_constraintTop_toBottomOf="@id/tv_capacity_label"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/tv_bays_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_bays_counter"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintBottom_toTopOf="@id/pb_occupancy"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginBottom="@dimen/spacing_small"/>

                    <TextView
                        android:id="@+id/tv_trend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/semanticSuccessCustom"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintBottom_toTopOf="@id/pb_occupancy"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginBottom="@dimen/spacing_small"/>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/pb_occupancy"
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:progress="82"
                        app:trackThickness="14dp"
                        app:trackCornerRadius="7dp"
                        app:trackColor="?attr/dividerColorCustom"
                        app:indicatorColor="?attr/colorPrimary"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_revenue"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_marginTop="@dimen/spacing_medium"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardBackgroundColor="?attr/branchSurfaceCustom"
                app:cardElevation="0dp"
                app:strokeColor="?attr/dividerColorCustom"
                app:strokeWidth="@dimen/stroke_thin"
                app:layout_constraintTop_toBottomOf="@id/card_occupancy"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/card_memberships">

                <View
                    android:id="@+id/glow_revenue"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/spacing_medium"
                    android:paddingStart="16dp">

                    <TextView
                        android:id="@+id/lbl_revenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_revenue_label"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_caption" />

                    <TextView
                        android:id="@+id/tv_revenue_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/lbl_revenue"
                        android:text="@string/dashboard_revenue_amount"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/spacing_xsmall" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_memberships"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_marginTop="@dimen/spacing_medium"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardBackgroundColor="?attr/branchSurfaceCustom"
                app:cardElevation="0dp"
                app:strokeColor="?attr/dividerColorCustom"
                app:strokeWidth="@dimen/stroke_thin"
                app:layout_constraintTop_toBottomOf="@id/card_occupancy"
                app:layout_constraintStart_toEndOf="@id/card_revenue"
                app:layout_constraintEnd_toEndOf="parent">

                <View
                    android:id="@+id/glow_memberships"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_medium">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/lbl_memberships"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_memberships_label"
                            android:textColor="?attr/textSecondaryCustom"
                            android:textSize="@dimen/text_size_caption" />

                        <TextView
                            android:id="@+id/tv_memberships_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_memberships_count"
                            android:textColor="?attr/textPrimaryCustom"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginTop="@dimen/spacing_xsmall" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="18sp"
                        android:alpha="0.5" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_branches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardBackgroundColor="?attr/branchSurfaceCustom"
                app:cardElevation="0dp"
                app:strokeColor="?attr/dividerColorCustom"
                app:strokeWidth="@dimen/stroke_thin"
                app:layout_constraintTop_toBottomOf="@id/card_memberships"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:id="@+id/icon_branches"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                    android:src="@drawable/parking_sign_24px"
                        app:tint="?attr/textPrimaryCustom" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_branches_title"
                            android:textColor="?attr/textPrimaryCustom"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_branches_subtitle"
                            android:textColor="?attr/textSecondaryCustom"
                            android:textSize="@dimen/text_size_small" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:text="›"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="22sp"
                        android:alpha="0.6" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_exit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardBackgroundColor="?attr/branchSurfaceCustom"
                app:cardElevation="0dp"
                app:strokeColor="?attr/dividerColorCustom"
                app:strokeWidth="@dimen/stroke_thin"
                app:layout_constraintTop_toBottomOf="@id/card_branches"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:id="@+id/icon_exit"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/door_sensor_24px"
                        app:tint="?attr/textPrimaryCustom" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exit_title"
                            android:textColor="?attr/textPrimaryCustom"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_exit_subtitle"
                            android:textColor="?attr/textSecondaryCustom"
                            android:textSize="@dimen/text_size_small" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:text="›"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="22sp"
                        android:alpha="0.6" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_kiosk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardBackgroundColor="?attr/branchSurfaceCustom"
                app:cardElevation="0dp"
                app:strokeColor="?attr/dividerColorCustom"
                app:strokeWidth="@dimen/stroke_thin"
                app:layout_constraintTop_toBottomOf="@id/card_exit"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_medium"
                    android:paddingStart="16dp">

                    <ImageView
                        android:id="@+id/icon_kiosk"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_centerVertical="true"
                        android:src="@android:drawable/ic_menu_compass"
                        app:tint="?attr/textPrimaryCustom" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="56dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_kiosk_title"
                            android:textColor="?attr/textPrimaryCustom"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_kiosk_subtitle"
                            android:textColor="?attr/textSecondaryCustom"
                            android:textSize="@dimen/text_size_small" />

                    </LinearLayout>

                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_audit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardBackgroundColor="?attr/branchSurfaceCustom"
                app:cardElevation="0dp"
                app:strokeColor="?attr/dividerColorCustom"
                app:strokeWidth="@dimen/stroke_thin"
                app:layout_constraintTop_toBottomOf="@id/card_kiosk"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:id="@+id/icon_audit"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_manage"
                        app:tint="?attr/textPrimaryCustom" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/audit_title"
                            android:textColor="?attr/textPrimaryCustom"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/audit_dashboard_subtitle"
                            android:textColor="?attr/textSecondaryCustom"
                            android:textSize="@dimen/text_size_small" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:text="›"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="22sp"
                        android:alpha="0.6" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_alerts_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/dashboard_alerts_title"
                android:textColor="?attr/textPrimaryCustom"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_audit"/>

            <TextView
                android:id="@+id/badge_critical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_badge_critical"
                android:background="?attr/colorError"
                android:textColor="?attr/colorOnError"
                android:textSize="@dimen/text_size_overline"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                app:layout_constraintTop_toTopOf="@id/tv_alerts_title"
                app:layout_constraintBottom_toBottomOf="@id/tv_alerts_title"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/alert_item_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small_plus"
                app:cardCornerRadius="@dimen/card_corner_radius_small"
                app:cardBackgroundColor="?attr/branchSurfaceCustom"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorError"
                app:strokeWidth="@dimen/stroke_thin"
                app:layout_constraintTop_toBottomOf="@id/tv_alerts_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:id="@+id/alert_icon_1"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@android:color/transparent"
                        android:src="@android:drawable/ic_dialog_alert"
                        app:tint="?attr/colorError"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/spacing_medium">

                        <TextView
                            android:id="@+id/alert_title_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/textPrimaryCustom"
                            android:textStyle="bold"
                            android:textSize="@dimen/text_size_body"/>

                        <TextView
                            android:id="@+id/alert_subtitle_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/textSecondaryCustom"
                            android:textSize="@dimen/text_size_small"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/alert_item_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                app:cardCornerRadius="@dimen/card_corner_radius_small"
                app:cardBackgroundColor="?attr/branchSurfaceCustom"
                app:cardElevation="0dp"
                app:strokeColor="?attr/dividerColorCustom"
                app:strokeWidth="@dimen/stroke_thin"
                app:layout_constraintTop_toBottomOf="@id/alert_item_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_medium">

                    <ImageView
                        android:id="@+id/alert_icon_2"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/btn_star_big_on"
                        app:tint="?attr/semanticSuccessCustom"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/spacing_medium">

                        <TextView
                            android:id="@+id/alert_title_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/textPrimaryCustom"
                            android:textStyle="bold"
                            android:textSize="@dimen/text_size_body"/>

                        <TextView
                            android:id="@+id/alert_subtitle_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/textSecondaryCustom"
                            android:textSize="@dimen/text_size_small"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_nav_height"
            android:background="?attr/homeSurfaceBackground"
            app:elevation="@dimen/elevation_none"
            app:itemIconTint="?attr/bottomNavItemColorCustom"
            app:itemBackground="@drawable/bg_bottom_nav_item"
            app:labelVisibilityMode="unlabeled"
            app:menu="@menu/home_bottom_menu" />

        <View
            android:id="@+id/bottom_nav_indicator"
            android:layout_width="@dimen/bottom_nav_indicator_width"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_bottom_nav_indicator"
            android:backgroundTint="?attr/bottomNavItemColorCustom"
            android:visibility="invisible" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
