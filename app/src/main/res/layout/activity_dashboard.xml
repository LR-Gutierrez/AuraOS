<?xml version="1.0" encoding="utf-8"?>
<!--
    Inicio · Parqueo·Control (claude.ai/design "Parqueo App").
    Flat page, branch chips, hero occupancy figure with a 4dp amber bar, entry / exit actions,
    today's figures between hairlines, per-branch occupancy card, kiosk shortcut and the
    latest vehicles on site.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/homeSurfaceBackground"
    android:orientation="vertical"
    tools:context=".DashboardActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <!-- Wordmark + date -->
            <LinearLayout
                android:id="@+id/header_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="32dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_wordmark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/pc_wordmark"
                    android:textAppearance="@style/TextAppearance.Pc.Wordmark" />

                <TextView
                    android:id="@+id/tv_today"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Pc.Mono"
                    tools:text="mié 15 oct" />
            </LinearLayout>

            <TextView
                android:id="@+id/cached_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/dashboard_cached_badge"
                android:textAppearance="@style/TextAppearance.Pc.Mono"
                android:visibility="gone" />

            <!-- Branch chips (bleed to the screen edges) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-20dp"
                android:layout_marginTop="28dp"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_branch_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Occupancy -->
            <TextView
                android:id="@+id/tv_occupancy_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:textAppearance="@style/TextAppearance.Lrg.Label"
                tools:text="Ocupación actual · Sede Centro" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_occupied"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pc_zero"
                    android:textAppearance="@style/TextAppearance.Pc.Display"
                    tools:text="38" />

                <TextView
                    android:id="@+id/tv_capacity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/aura_mono"
                    android:textColor="?attr/textMutedCustom"
                    android:textSize="20sp"
                    tools:text="/ 120" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/pb_occupancy"
                style="@style/Widget.Pc.Progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:importantForAccessibility="no"
                android:max="100"
                tools:progress="32" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_occupancy_pct"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Pc.Mono"
                    tools:text="32% ocupado" />

                <TextView
                    android:id="@+id/tv_free"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Pc.Mono"
                    tools:text="82 puestos libres" />
            </LinearLayout>

            <!-- Primary actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_register_entry"
                    style="@style/Widget.Lrg.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/pc_register_entry" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_register_exit"
                    style="@style/Widget.Pc.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/pc_register_exit" />
            </LinearLayout>

            <!-- Today -->
            <View
                style="@style/Widget.Pc.Hairline"
                android:layout_marginTop="28dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingVertical="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pc_entries"
                        android:textAppearance="@style/TextAppearance.Lrg.Label" />

                    <TextView
                        android:id="@+id/tv_entries_today"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/pc_zero"
                        android:textAppearance="@style/TextAppearance.Pc.Stat" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="?attr/dividerColorCustom" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingVertical="16dp"
                    android:paddingStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pc_exits"
                        android:textAppearance="@style/TextAppearance.Lrg.Label" />

                    <TextView
                        android:id="@+id/tv_exits_today"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/pc_zero"
                        android:textAppearance="@style/TextAppearance.Pc.Stat" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="?attr/dividerColorCustom" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingVertical="16dp"
                    android:paddingStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pc_revenue"
                        android:textAppearance="@style/TextAppearance.Lrg.Label" />

                    <TextView
                        android:id="@+id/tv_revenue_today"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/pc_money_zero"
                        android:textAppearance="@style/TextAppearance.Pc.Stat" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/Widget.Pc.Hairline" />

            <!-- Expiring memberships (proactive alert, only when there are any) -->
            <LinearLayout
                android:id="@+id/row_membership_alert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_lrg_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tv_membership_alert_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Lrg.Label"
                    android:textColor="?attr/accentTextCustom"
                    tools:text="02 membresías por vencer" />

                <TextView
                    android:id="@+id/tv_membership_alert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.Pc.RowTitle"
                    tools:text="Carlos Méndez · Mensual · 3 días" />
            </LinearLayout>

            <!-- All branches -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/pc_all_branches"
                    android:textAppearance="@style/TextAppearance.Pc.Section" />

                <TextView
                    android:id="@+id/tv_total_vehicles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Pc.Mono"
                    tools:text="107 vehículos" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_branch_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_lrg_card"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp" />

            <!-- Kiosk -->
            <LinearLayout
                android:id="@+id/card_kiosk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_pc_outline_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pc_kiosk_mode"
                        android:textAppearance="@style/TextAppearance.Pc.RowTitle"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_kiosk_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.Lrg.Body"
                        tools:text="Autoservicio de entrada y pago para Sede Centro" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:importantForAccessibility="no"
                    android:text="@string/pc_arrow"
                    android:textColor="?attr/accentTextCustom"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- On site -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/pc_on_site"
                    android:textAppearance="@style/TextAppearance.Pc.Section" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_see_all"
                    style="@style/Widget.Pc.TextLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Ver los 38" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_on_site"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_on_site_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="14dp"
                android:text="@string/pc_on_site_empty"
                android:textAppearance="@style/TextAppearance.Pc.Hint"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/tab_bar"
        layout="@layout/view_pc_tab_bar" />

</LinearLayout>
