<?xml version="1.0" encoding="utf-8"?>
<!--
    Perfil (Parqueo·Control). Avatar with initials or photo, operation shortcuts, security,
    appearance, sign out and the build line.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/homeSurfaceBackground"
    android:orientation="vertical"
    tools:context=".ProfileActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <!-- Identity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/edit_avatar_button"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_pc_circle_surface"
                    android:clickable="true"
                    android:contentDescription="@string/profile_edit_avatar"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <TextView
                        android:id="@+id/tv_avatar_initial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/aura_mono"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="MR" />

                    <ImageView
                        android:id="@+id/iv_avatar_photo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/profile_avatar_title"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Pc.Stat"
                        tools:text="María Rodríguez" />

                    <TextView
                        android:id="@+id/tv_profile_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Pc.Mono"
                        tools:text="maria@parqueo.com · 03 sedes" />
                </LinearLayout>
            </LinearLayout>

            <!-- Operation -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:paddingBottom="6dp"
                android:text="@string/pc_operation"
                android:textAppearance="@style/TextAppearance.Lrg.Label" />

            <include
                android:id="@+id/row_branches"
                layout="@layout/item_pc_nav_row" />

            <include
                android:id="@+id/row_rates"
                layout="@layout/item_pc_nav_row" />

            <include
                android:id="@+id/row_memberships"
                layout="@layout/item_pc_nav_row" />

            <include
                android:id="@+id/row_kiosk"
                layout="@layout/item_pc_nav_row" />

            <!-- Security & appearance -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:paddingBottom="6dp"
                android:text="@string/pc_preferences"
                android:textAppearance="@style/TextAppearance.Lrg.Label" />

            <View style="@style/Widget.Pc.Hairline" />

            <LinearLayout
                android:id="@+id/card_security"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_biometric_auth"
                        android:textAppearance="@style/TextAppearance.Pc.RowTitle" />

                    <TextView
                        android:id="@+id/tv_biometric_meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.Pc.Mono"
                        tools:text="Huella activada" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_biometric"
                    style="@style/Widget.Pc.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@string/profile_biometric_auth" />
            </LinearLayout>

            <View style="@style/Widget.Pc.Hairline" />

            <LinearLayout
                android:id="@+id/card_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pc_appearance"
                    android:textAppearance="@style/TextAppearance.Pc.RowTitle" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_group_theme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_pc_segment"
                    android:padding="2dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_theme_crystal"
                        style="@style/Widget.Pc.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pc_theme_light" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_theme_midnight"
                        style="@style/Widget.Pc.Segment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:text="@string/pc_theme_dark" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <View style="@style/Widget.Pc.Hairline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_logout"
                style="@style/Widget.Pc.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/pc_sign_out" />

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Pc.Mono"
                android:textSize="12sp"
                tools:text="Parqueo·Control 1.0.0 · build 1" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/tab_bar"
        layout="@layout/view_pc_tab_bar" />

</LinearLayout>
