<?xml version="1.0" encoding="utf-8"?>
<!--
    Modo kiosko · autoservicio (Parqueo·Control). Welcome with free spots, a large amber
    "Entrar" action, the membership (NFC) path, the NFC reader screen and its result.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/kiosk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/homeSurfaceBackground"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingBottom="28dp"
    tools:context=".KioskActivity">

    <!-- Header: mark + wordmark over branch (tap to switch), exit -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <LinearLayout
            android:id="@+id/brand_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo_aura" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pc_wordmark"
                    android:textAppearance="@style/TextAppearance.Pc.Wordmark" />

                <TextView
                    android:id="@+id/tv_branch_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Lrg.Label"
                    tools:text="Autoservicio · Sede Centro" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_exit_kiosk"
            style="@style/Widget.Pc.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/aura_mono"
            android:paddingHorizontal="12dp"
            android:text="@string/pc_kiosk_exit"
            android:textColor="?attr/textMutedCustom"
            android:textSize="12sp"
            app:strokeColor="?attr/dividerColorCustom" />
    </LinearLayout>

    <!-- Home -->
    <LinearLayout
        android:id="@+id/section_home"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/pc_welcome"
            android:textAppearance="@style/TextAppearance.Pc.KioskDisplay" />

        <TextView
            android:id="@+id/tv_kiosk_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.3"
            android:textColor="?attr/textSecondaryCustom"
            android:textSize="18sp"
            tools:text="Hay 82 puestos libres en este momento." />

        <LinearLayout
            android:id="@+id/card_ticket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_pc_kiosk_primary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="120dp"
            android:orientation="horizontal"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/aura_sans"
                    android:letterSpacing="-0.02"
                    android:text="@string/pc_kiosk_enter"
                    android:textColor="?attr/onAccentCustom"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/pc_kiosk_enter_sub"
                    android:textColor="?attr/onAccentCustom"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/pc_arrow"
                android:textColor="?attr/onAccentCustom"
                android:textSize="28sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_membership"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pc_outline_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="76dp"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_pc_nfc"
                app:tint="?attr/accentTextCustom" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingVertical="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pc_kiosk_member"
                    android:textAppearance="@style/TextAppearance.Pc.Section" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/pc_kiosk_member_sub"
                    android:textAppearance="@style/TextAppearance.Lrg.Body" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/pc_arrow"
                android:textColor="?attr/accentTextCustom"
                android:textSize="24sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View style="@style/Widget.Pc.Hairline" />

        <TextView
            android:id="@+id/tv_rates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:textAppearance="@style/TextAppearance.Pc.Mono"
            android:textSize="12sp"
            tools:text="Auto $2.00 · Camión $6.00 · Moto $1.00 por día" />
    </LinearLayout>

    <!-- NFC reader -->
    <LinearLayout
        android:id="@+id/card_nfc_scanning"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nfc_cancel"
            style="@style/Widget.Pc.TextLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pc_back_arrow"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:text="@string/pc_kiosk_nfc_title"
            android:textAppearance="@style/TextAppearance.Pc.KioskTitle" />

        <TextView
            android:id="@+id/tv_nfc_status_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/pc_kiosk_nfc_hint"
            android:textColor="?attr/textSecondaryCustom"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/nfc_reader_box"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pc_reader_idle"
            android:gravity="center"
            android:minHeight="300dp"
            android:orientation="vertical"
            android:padding="20dp">

            <FrameLayout
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:background="@drawable/bg_pc_circle_hairline">

                <FrameLayout
                    android:layout_width="124dp"
                    android:layout_height="124dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pc_circle_outline">

                    <FrameLayout
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_pc_circle_accent">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_pc_nfc"
                            app:tint="?attr/onAccentCustom" />
                    </FrameLayout>
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tv_nfc_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Pc.Section"
                tools:text="Esperando tarjeta…" />

            <TextView
                android:id="@+id/tv_nfc_member_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Pc.Mono"
                android:visibility="gone"
                tools:text="Carlos Méndez" />
        </LinearLayout>
    </LinearLayout>

    <!-- NFC result -->
    <LinearLayout
        android:id="@+id/card_nfc_processing"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_pc_circle_accent">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_pc_check"
                app:tint="?attr/onAccentCustom" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Pc.KioskTitle"
            tools:text="Bienvenido, Carlos" />

        <TextView
            android:id="@+id/tv_nfc_processing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingMultiplier="1.3"
            android:textColor="?attr/textSecondaryCustom"
            android:textSize="17sp"
            tools:text="Entrada registrada con tu membresía. Adelante." />

        <TextView
            android:id="@+id/tv_result_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textAppearance="@style/TextAppearance.Pc.Mono"
            tools:text="Mensual · 07:42 · vigente hasta 30/11/2026" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_result_home"
            style="@style/Widget.Pc.TextLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/pc_back_home"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
