<?xml version="1.0" encoding="utf-8"?>
<!--
    Analíticas (Parqueo·Control). Period / branch / type filters, period revenue, a tappable
    revenue bar chart, vehicles and average ticket, breakdowns and the exits behind the numbers.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/homeSurfaceBackground"
    android:orientation="vertical"
    tools:context=".AnalyticsActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/title_activity_analytics"
                android:textAppearance="@style/TextAppearance.Pc.H2" />

            <!-- Filters -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_period"
                    style="@style/Widget.Pc.Select"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    tools:text="7 días" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_branch"
                    style="@style/Widget.Pc.Select"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    tools:text="Todas las sedes" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_type"
                    style="@style/Widget.Pc.Select"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    tools:text="Todos los tipos" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/loading_overlay"
                style="@style/Widget.Pc.Progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- Total -->
            <TextView
                android:id="@+id/tv_total_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textAppearance="@style/TextAppearance.Lrg.Label"
                tools:text="Ingresos · últimos 7 días" />

            <TextView
                android:id="@+id/tv_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/pc_money_zero"
                android:textAppearance="@style/TextAppearance.Pc.Amount" />

            <TextView
                android:id="@+id/tv_total_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.Pc.Mono"
                tools:text="+12.3 % vs periodo anterior" />

            <!-- Chart -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_lrg_card"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="18dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_sel_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Pc.Mono"
                        android:textColor="?attr/textSecondaryCustom"
                        tools:text="mié 15 oct" />

                    <TextView
                        android:id="@+id/tv_sel_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Pc.MonoValue"
                        android:textSize="16sp"
                        tools:text="$231.50" />
                </LinearLayout>

                <com.beta.auraos.ui.widget.BarChartView
                    android:id="@+id/chart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" />
            </LinearLayout>

            <!-- Vehicles / average ticket -->
            <View
                style="@style/Widget.Pc.Hairline"
                android:layout_marginTop="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingVertical="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pc_vehicles"
                        android:textAppearance="@style/TextAppearance.Lrg.Label" />

                    <TextView
                        android:id="@+id/tv_vehicles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/pc_zero"
                        android:textAppearance="@style/TextAppearance.Pc.Stat" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="?attr/dividerColorCustom" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingVertical="16dp"
                    android:paddingStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pc_avg_ticket"
                        android:textAppearance="@style/TextAppearance.Lrg.Label" />

                    <TextView
                        android:id="@+id/tv_avg_ticket"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/pc_money_zero"
                        android:textAppearance="@style/TextAppearance.Pc.Stat" />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/Widget.Pc.Hairline" />

            <LinearLayout
                android:id="@+id/ll_breakdowns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Exits behind the numbers -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:accessibilityHeading="true"
                android:paddingBottom="4dp"
                android:text="@string/pc_period_exits"
                android:textAppearance="@style/TextAppearance.Pc.Section" />

            <LinearLayout
                android:id="@+id/ll_exits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="14dp"
                android:text="@string/pc_no_exits"
                android:textAppearance="@style/TextAppearance.Pc.Hint"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_load_more"
                style="@style/Widget.Pc.TextLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                tools:text="Ver 20 más" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/tab_bar"
        layout="@layout/view_pc_tab_bar" />

</LinearLayout>
