<?xml version="1.0" encoding="utf-8"?>
<!--
    Caja y auditoría (Parqueo·Control). Period revenue, breakdown by payment method, the cash
    count that the closure records, pending movements and closure history.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/homeSurfaceBackground"
    android:orientation="vertical"
    tools:context=".ui.audit.AuditActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/pc_cash_title"
                android:textAppearance="@style/TextAppearance.Pc.H2" />

            <TextView
                android:id="@+id/tv_period_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.Pc.Mono"
                tools:text="Desde 14 oct 19:02 · M. Rodríguez" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-20dp"
                android:layout_marginTop="28dp"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_branch_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Period revenue -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/pc_period_revenue"
                android:textAppearance="@style/TextAppearance.Lrg.Label" />

            <TextView
                android:id="@+id/tv_period_revenue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/pc_money_zero"
                android:textAppearance="@style/TextAppearance.Pc.Amount" />

            <TextView
                android:id="@+id/tv_period_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.Pc.Mono"
                tools:text="46 cobros · Sede Centro" />

            <LinearLayout
                android:id="@+id/ll_breakdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical" />

            <!-- Cash count: the drawer against what was charged in cash -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_lrg_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/pc_cash_count"
                    android:textAppearance="@style/TextAppearance.Pc.Section" />

                <LinearLayout
                    android:id="@+id/row_opening_float"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pc_opening_float"
                        android:textAppearance="@style/TextAppearance.Pc.Mono"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_opening_float"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Pc.Mono"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="14sp"
                        tools:text="$20.00" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pc_cash_collected"
                        android:textAppearance="@style/TextAppearance.Pc.Mono"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_cash_collected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Pc.Mono"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="14sp"
                        tools:text="$20.00" />
                </LinearLayout>

                <View
                    style="@style/Widget.Pc.Hairline"
                    android:layout_marginTop="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pc_cash_expected"
                        android:textAppearance="@style/TextAppearance.Pc.Mono"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_cash_expected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Pc.Mono"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textSize="14sp"
                        tools:text="$20.00" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:labelFor="@id/et_cash_counted"
                    android:text="@string/pc_cash_counted"
                    android:textAppearance="@style/TextAppearance.Lrg.Label" />

                <EditText
                    android:id="@+id/et_cash_counted"
                    style="@style/Widget.Pc.Field"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:hint="@string/pc_amount_hint"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_diff_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pc_difference"
                        android:textAppearance="@style/TextAppearance.Pc.Body"
                        android:textColor="?attr/textSecondaryCustom" />

                    <TextView
                        android:id="@+id/tv_diff_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pc_dash"
                        android:textAppearance="@style/TextAppearance.Pc.MonoValue"
                        android:textSize="20sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/pc_closure_hint"
                    android:textAppearance="@style/TextAppearance.Pc.Hint" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_execute_closure"
                style="@style/Widget.Pc.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/pc_close_cash" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/loading_overlay"
                style="@style/Widget.Pc.Progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- Movements -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:accessibilityHeading="true"
                android:paddingBottom="10dp"
                android:text="@string/pc_movements"
                android:textAppearance="@style/TextAppearance.Pc.Section" />

            <LinearLayout
                android:id="@+id/ll_movements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_no_movements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="14dp"
                android:text="@string/pc_no_movements"
                android:textAppearance="@style/TextAppearance.Pc.Hint"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- History -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:accessibilityHeading="true"
                android:paddingBottom="10dp"
                android:text="@string/pc_closure_history"
                android:textAppearance="@style/TextAppearance.Pc.Section" />

            <LinearLayout
                android:id="@+id/closure_history_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_empty_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="14dp"
                android:text="@string/audit_no_closures"
                android:textAppearance="@style/TextAppearance.Pc.Hint"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/tab_bar"
        layout="@layout/view_pc_tab_bar" />

</LinearLayout>
