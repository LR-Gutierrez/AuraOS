<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/homeSurfaceBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="@dimen/elevation_none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_header_height"
            android:background="?attr/navbarBackground"
            android:paddingHorizontal="@dimen/spacing_large">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:background="?attr/glassCardBackgroundCustom"
                android:contentDescription="@string/action_back"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="?attr/textPrimaryCustom"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:fontFamily="sans-serif-black"
                android:text="@string/membership_new_title"
                android:textColor="?attr/textPrimaryCustom"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btn_back"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="true"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/container_padding"
            android:paddingTop="@dimen/spacing_large"
            android:paddingBottom="@dimen/spacing_xxlarge">

            <!-- Card: Member Info -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_member_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardBackgroundColor="?attr/branchSurfaceCustom"
                app:strokeColor="?attr/dividerColorCustom"
                app:strokeWidth="@dimen/stroke_thin">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:id="@+id/lbl_section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/membership_section_info"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_overline"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/et_member_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:background="?attr/hollowInputBackground"
                        android:drawableStart="@drawable/ic_person"
                        android:drawablePadding="@dimen/spacing_small"
                        android:drawableTint="?attr/textSecondaryCustom"
                        android:fontFamily="sans-serif"
                        android:hint="@string/membership_hint_name"
                        android:imeOptions="actionNext"
                        android:inputType="text|textCapWords"
                        android:maxLines="1"
                        android:padding="@dimen/spacing_medium"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textColorHint="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintTop_toBottomOf="@id/lbl_section" />

                    <!-- Tier Section Label -->
                    <TextView
                        android:id="@+id/lbl_tier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/membership_hint_tier"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_caption"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/et_member_name" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_tier"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        app:chipSpacingHorizontal="@dimen/spacing_small"
                        app:singleSelection="true"
                        app:layout_constraintTop_toBottomOf="@id/lbl_tier">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_elite"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/membership_tier_elite"
                            android:textColor="@color/chip_selector_text"
                            android:textSize="@dimen/text_size_small"
                            app:chipBackgroundColor="@color/chip_selector_bg"
                            app:chipStrokeColor="@color/chip_selector_stroke"
                            app:chipStrokeWidth="@dimen/stroke_thin"
                            app:chipCornerRadius="@dimen/radius_full" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_premium"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/membership_tier_premium"
                            android:textColor="@color/chip_selector_text"
                            android:textSize="@dimen/text_size_small"
                            app:chipBackgroundColor="@color/chip_selector_bg"
                            app:chipStrokeColor="@color/chip_selector_stroke"
                            app:chipStrokeWidth="@dimen/stroke_thin"
                            app:chipCornerRadius="@dimen/radius_full" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_basic"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/membership_tier_basic"
                            android:textColor="@color/chip_selector_text"
                            android:textSize="@dimen/text_size_small"
                            app:chipBackgroundColor="@color/chip_selector_bg"
                            app:chipStrokeColor="@color/chip_selector_stroke"
                            app:chipStrokeWidth="@dimen/stroke_thin"
                            app:chipCornerRadius="@dimen/radius_full" />

                    </com.google.android.material.chip.ChipGroup>

                    <EditText
                        android:id="@+id/et_end_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:background="?attr/hollowInputBackground"
                        android:clickable="true"
                        android:drawableStart="@drawable/ic_calendar"
                        android:drawablePadding="@dimen/spacing_small"
                        android:drawableTint="?attr/textSecondaryCustom"
                        android:focusable="false"
                        android:fontFamily="sans-serif"
                        android:hint="@string/membership_hint_end_date"
                        android:inputType="none"
                        android:maxLines="1"
                        android:padding="@dimen/spacing_medium"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textColorHint="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintTop_toBottomOf="@id/chip_group_tier" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card: NFC Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_nfc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardBackgroundColor="?attr/branchSurfaceCustom"
                app:strokeColor="?attr/dividerColorCustom"
                app:strokeWidth="@dimen/stroke_thin">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:id="@+id/lbl_section_nfc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/membership_section_nfc"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_overline"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_nfc_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:contentDescription="@string/membership_nfc_icon_desc"
                        android:src="@drawable/ic_nfc"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/lbl_section_nfc"
                        app:tint="?attr/textSecondaryCustom" />

                    <TextView
                        android:id="@+id/tv_nfc_description"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:fontFamily="sans-serif"
                        android:gravity="center_vertical"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/membership_nfc_description"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_small"
                        app:layout_constraintBottom_toBottomOf="@id/iv_nfc_icon"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iv_nfc_icon"
                        app:layout_constraintTop_toTopOf="@id/iv_nfc_icon" />

                    <EditText
                        android:id="@+id/et_card_uuid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:background="?attr/hollowInputBackground"
                        android:focusable="false"
                        android:fontFamily="sans-serif"
                        android:hint="@string/membership_hint_card_uuid"
                        android:maxLines="1"
                        android:padding="@dimen/spacing_medium"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textColorHint="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintTop_toBottomOf="@id/iv_nfc_icon" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_scan_nfc"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/primary_button_height"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:drawableStart="@drawable/ic_nfc"
                        android:drawablePadding="@dimen/spacing_small"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/membership_scan_nfc"
                        android:textAllCaps="false"
                        android:textSize="@dimen/text_size_button"
                        app:backgroundTint="?attr/colorPrimary"
                        app:cornerRadius="@dimen/button_corner_radius_full"
                        app:iconTint="?attr/colorOnPrimary"
                        app:layout_constraintTop_toBottomOf="@id/et_card_uuid" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/primary_button_height"
                android:layout_marginTop="@dimen/spacing_xxlarge"
                android:fontFamily="sans-serif-black"
                android:text="@string/membership_save_action"
                android:textAllCaps="false"
                android:textSize="@dimen/text_size_button"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="@dimen/button_corner_radius_full" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="?attr/colorPrimary"
            app:indicatorSize="48dp"
            app:trackThickness="4dp" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
