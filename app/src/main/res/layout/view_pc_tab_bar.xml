<?xml version="1.0" encoding="utf-8"?>
<!--
    Tab bar in the BCV Tracker manner: surface with a top hairline, unlabeled 20dp icons
    (secondary when idle, accent text when active) and a 14x3dp amber bar under the active tab.
    Tab names stay available to TalkBack through the menu titles.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_lrg_bottom_bar">

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        style="@style/Widget.Pc.TabBar" />

    <View
        android:id="@+id/tab_indicator"
        android:layout_width="14dp"
        android:layout_height="3dp"
        android:background="@drawable/bg_pc_tab_indicator"
        android:importantForAccessibility="no"
        android:visibility="invisible" />
</FrameLayout>
