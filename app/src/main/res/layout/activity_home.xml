<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/homeSurfaceBackground"
    tools:context=".HomeActivity">

    <!-- Top App Bar Glass -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_header_height"
        android:background="?attr/navbarBackground"
        android:paddingHorizontal="@dimen/spacing_large"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_user_profile"
            android:layout_width="@dimen/avatar_size"
            android:layout_height="@dimen/avatar_size"
            android:contentDescription="@string/cd_user_profile"
            android:src="@drawable/ic_profile_circle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent" />

        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:fontFamily="sans-serif-black"
            android:text="@string/home_app_title"
            android:textColor="?attr/textPrimaryCustom"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_user_profile"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_cloud_status"
            android:layout_width="@dimen/icon_size_medium"
            android:layout_height="@dimen/icon_size_medium"
            android:contentDescription="@string/network_status"
            android:src="@android:drawable/stat_sys_upload"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/textSecondaryCustom" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ScrollView principal -->
    <ScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintTop_toBottomOf="@id/header_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/container_padding"
            android:paddingTop="@dimen/spacing_large"
            android:paddingBottom="@dimen/spacing_xxlarge">

            <!-- Video Feed Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_video_feed"
                android:layout_width="match_parent"
                android:layout_height="@dimen/video_feed_height"
                android:backgroundTint="?attr/videoFeedBackgroundCustom"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardElevation="@dimen/elevation_none"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="@dimen/stroke_none">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/tv_live_feed_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_small_plus"
                        android:background="?attr/liveBadgeBackgroundCustom"
                        android:paddingHorizontal="@dimen/spacing_small"
                        android:paddingVertical="@dimen/spacing_xsmall"
                        android:text="@string/live_feed_label"
                        android:textColor="?attr/liveBadgeTextCustom"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- OCR Data Glass Card -->
            <FrameLayout
                android:id="@+id/container_ocr_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:background="?attr/glassCardBackgroundCustom"
                android:padding="@dimen/spacing_large"
                app:layout_constraintTop_toBottomOf="@id/card_video_feed">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/lbl_ocr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/ocr_status_label"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_overline"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_plate_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/sample_plate_number"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textSize="@dimen/text_size_plate"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/lbl_ocr" />

                    <TextView
                        android:id="@+id/tv_db_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:fontFamily="sans-serif"
                        android:text="@string/plate_validation_status"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_plate_number" />

                    <TextView
                        android:id="@+id/lbl_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_large"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/vehicle_category_label"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_overline"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_db_status" />

                    <LinearLayout
                        android:id="@+id/layout_vehicle_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/toggle_height"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@id/lbl_category">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_light_vehicle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="@dimen/spacing_small"
                            android:layout_weight="1"
                            android:background="@drawable/btn_light_vehicle_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingVertical="@dimen/spacing_small"
                            android:text="@string/vehicle_type_light"
                            android:textAllCaps="false"
                            android:textColor="@drawable/btn_vehicle_text_selector"
                            app:cornerRadius="@dimen/button_corner_radius_large"
                            app:rippleColor="@android:color/transparent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_heavy_vehicle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/btn_heavy_vehicle_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingVertical="@dimen/spacing_small"
                            android:text="@string/vehicle_type_heavy"
                            android:textAllCaps="false"
                            android:textColor="@drawable/btn_vehicle_text_selector"
                            app:cornerRadius="@dimen/button_corner_radius_large"
                            app:rippleColor="@android:color/transparent" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>

            <!-- Bodywork Data Glass Card -->
            <FrameLayout
                android:id="@+id/container_bodywork_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:background="?attr/glassCardBackgroundCustom"
                android:padding="@dimen/spacing_large"
                app:layout_constraintTop_toBottomOf="@id/container_ocr_data">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/lbl_bodywork"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/bodywork_status_label"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_overline"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <GridLayout
                        android:id="@+id/grid_photos"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/photo_grid_height"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:columnCount="2"
                        android:rowCount="2"
                        app:layout_constraintTop_toBottomOf="@id/lbl_bodywork">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="@dimen/grid_item_margin"
                            android:layout_rowWeight="1"
                            android:background="?attr/glassCardBackgroundCustom">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/cd_photo_front"
                                android:scaleType="centerCrop"
                                android:src="@android:drawable/ic_menu_camera"
                                app:tint="?attr/photoPlaceholderTintCustom" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="@dimen/grid_item_margin"
                            android:layout_rowWeight="1"
                            android:background="?attr/glassCardBackgroundCustom">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/cd_photo_rear"
                                android:scaleType="centerCrop"
                                android:src="@android:drawable/ic_menu_camera"
                                app:tint="?attr/photoPlaceholderTintCustom" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="@dimen/grid_item_margin"
                            android:layout_rowWeight="1"
                            android:background="?attr/glassCardBackgroundCustom">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/cd_photo_left"
                                android:scaleType="centerCrop"
                                android:src="@android:drawable/ic_menu_camera"
                                app:tint="?attr/photoPlaceholderTintCustom" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="@dimen/grid_item_margin"
                            android:layout_rowWeight="1"
                            android:background="?attr/glassCardBackgroundCustom">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/cd_photo_right"
                                android:scaleType="centerCrop"
                                android:src="@android:drawable/ic_menu_camera"
                                app:tint="?attr/photoPlaceholderTintCustom" />
                        </FrameLayout>
                    </GridLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>

            <!-- Confirm Entry Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_entry"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/primary_button_height"
                android:layout_marginTop="@dimen/spacing_xxlarge"
                android:layout_marginBottom="@dimen/spacing_large"
                android:text="@string/action_confirm_entry"
                android:textAllCaps="false"
                android:textSize="@dimen/text_size_button"
                android:textStyle="bold"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="@dimen/button_corner_radius_full"
                app:layout_constraintTop_toBottomOf="@id/container_bodywork_data" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:background="?attr/bottomNavbarBackground"
        app:elevation="@dimen/elevation_none"
        app:itemIconTint="?attr/bottomNavItemColorCustom"
        app:itemTextColor="?attr/bottomNavItemColorCustom"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/home_bottom_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
