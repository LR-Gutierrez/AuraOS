<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/homeSurfaceBackground"
    tools:context=".HomeActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="@dimen/elevation_none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_header_height"
            android:background="?attr/navbarBackground"
            android:paddingHorizontal="@dimen/spacing_large"
            app:layout_scrollFlags="scroll|enterAlways">

            <TextView
                android:id="@+id/tv_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/title_activity_home"
                android:textColor="?attr/textPrimaryCustom"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="true"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/container_padding"
            android:paddingTop="@dimen/spacing_large"
            android:paddingBottom="@dimen/spacing_xxlarge">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_video_feed"
                android:layout_width="match_parent"
                android:layout_height="@dimen/video_feed_height"
                android:backgroundTint="?attr/videoFeedBackgroundCustom"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardElevation="@dimen/elevation_none"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="@dimen/stroke_none">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/tv_live_feed_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_small_plus"
                        android:background="?attr/liveBadgeBackgroundCustom"
                        android:paddingHorizontal="@dimen/spacing_small"
                        android:paddingVertical="@dimen/spacing_xsmall"
                        android:text="@string/live_feed_label"
                        android:textColor="?attr/liveBadgeTextCustom"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <FrameLayout
                android:id="@+id/container_ocr_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:background="?attr/glassCardBackgroundCustom"
                android:padding="@dimen/spacing_large"
                app:layout_constraintTop_toBottomOf="@id/card_video_feed">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/lbl_ocr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/ocr_status_label"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_overline"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_plate_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/sample_plate_number"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textSize="@dimen/text_size_plate"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/lbl_ocr" />

                    <TextView
                        android:id="@+id/tv_db_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:fontFamily="sans-serif"
                        android:text="@string/plate_validation_status"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_plate_number" />

                    <TextView
                        android:id="@+id/lbl_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_large"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/vehicle_category_label"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_overline"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_db_status" />

                    <LinearLayout
                        android:id="@+id/layout_vehicle_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/toggle_height"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@id/lbl_category">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_light_vehicle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="@dimen/spacing_small"
                            android:layout_weight="1"
                            android:background="@drawable/btn_light_vehicle_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="@string/vehicle_type_light"
                            android:textAllCaps="false"
                            android:textColor="@drawable/btn_vehicle_text_selector"
                            app:cornerRadius="@dimen/button_corner_radius_large"
                            app:rippleColor="@android:color/transparent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_heavy_vehicle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/btn_heavy_vehicle_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="@string/vehicle_type_heavy"
                            android:textAllCaps="false"
                            android:textColor="@drawable/btn_vehicle_text_selector"
                            app:cornerRadius="@dimen/button_corner_radius_large"
                            app:rippleColor="@android:color/transparent" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/container_bodywork_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:background="?attr/glassCardBackgroundCustom"
                android:padding="@dimen/spacing_large"
                app:layout_constraintTop_toBottomOf="@id/container_ocr_data">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/lbl_bodywork"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/bodywork_status_label"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_overline"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <GridLayout
                        android:id="@+id/grid_photos"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/photo_grid_height"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:columnCount="2"
                        android:rowCount="2"
                        app:layout_constraintTop_toBottomOf="@id/lbl_bodywork">

                        <FrameLayout
                            android:id="@+id/container_front"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="@dimen/grid_item_margin"
                            android:layout_rowWeight="1"
                            android:background="?attr/glassCardBackgroundCustom"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="6dp">

                            <ImageView
                                android:id="@+id/iv_front"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/cd_photo_front"
                                android:scaleType="fitCenter"
                                android:src="@drawable/front" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_gravity="bottom"
                                android:background="?attr/photoOverlayCustom" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|center_horizontal"
                                android:layout_marginBottom="8dp"
                                android:fontFamily="sans-serif-black"
                                android:text="@string/photo_label_front"
                                android:textColor="?attr/textPrimaryCustom"
                                android:textSize="@dimen/text_size_caption"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/btn_retake_front"
                                android:layout_width="@dimen/icon_size_large"
                                android:layout_height="@dimen/icon_size_large"
                                android:layout_gravity="top|end"
                                android:layout_margin="4dp"
                                android:background="?attr/glassCardBackgroundCustom"
                                android:contentDescription="@string/action_retake"
                                android:elevation="2dp"
                                android:padding="4dp"
                                android:src="@drawable/ic_retake"
                                android:tint="?attr/textPrimaryCustom"
                                android:visibility="gone" />

                            <ImageButton
                                android:id="@+id/btn_delete_front"
                                android:layout_width="@dimen/icon_size_large"
                                android:layout_height="@dimen/icon_size_large"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="4dp"
                                android:layout_marginBottom="44dp"
                                android:background="?attr/glassCardBackgroundCustom"
                                android:contentDescription="@string/action_delete"
                                android:elevation="2dp"
                                android:padding="4dp"
                                android:src="@drawable/ic_delete"
                                android:tint="?attr/textPrimaryCustom"
                                android:visibility="gone" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/container_rear"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="@dimen/grid_item_margin"
                            android:layout_rowWeight="1"
                            android:background="?attr/glassCardBackgroundCustom"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="6dp">

                            <ImageView
                                android:id="@+id/iv_rear"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/cd_photo_rear"
                                android:scaleType="fitCenter"
                                android:src="@drawable/rear" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_gravity="bottom"
                                android:background="?attr/photoOverlayCustom" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|center_horizontal"
                                android:layout_marginBottom="8dp"
                                android:fontFamily="sans-serif-black"
                                android:text="@string/photo_label_rear"
                                android:textColor="?attr/textPrimaryCustom"
                                android:textSize="@dimen/text_size_caption"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/btn_retake_rear"
                                android:layout_width="@dimen/icon_size_large"
                                android:layout_height="@dimen/icon_size_large"
                                android:layout_gravity="top|end"
                                android:layout_margin="4dp"
                                android:background="?attr/glassCardBackgroundCustom"
                                android:contentDescription="@string/action_retake"
                                android:elevation="2dp"
                                android:padding="4dp"
                                android:src="@drawable/ic_retake"
                                android:tint="?attr/textPrimaryCustom"
                                android:visibility="gone" />

                            <ImageButton
                                android:id="@+id/btn_delete_rear"
                                android:layout_width="@dimen/icon_size_large"
                                android:layout_height="@dimen/icon_size_large"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="4dp"
                                android:layout_marginBottom="44dp"
                                android:background="?attr/glassCardBackgroundCustom"
                                android:contentDescription="@string/action_delete"
                                android:elevation="2dp"
                                android:padding="4dp"
                                android:src="@drawable/ic_delete"
                                android:tint="?attr/textPrimaryCustom"
                                android:visibility="gone" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/container_left"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="@dimen/grid_item_margin"
                            android:layout_rowWeight="1"
                            android:background="?attr/glassCardBackgroundCustom"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="6dp">

                            <ImageView
                                android:id="@+id/iv_left"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/cd_photo_left"
                                android:scaleType="fitCenter"
                                android:src="@drawable/left" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_gravity="bottom"
                                android:background="?attr/photoOverlayCustom" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|center_horizontal"
                                android:layout_marginBottom="8dp"
                                android:fontFamily="sans-serif-black"
                                android:text="@string/photo_label_left"
                                android:textColor="?attr/textPrimaryCustom"
                                android:textSize="@dimen/text_size_caption"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/btn_retake_left"
                                android:layout_width="@dimen/icon_size_large"
                                android:layout_height="@dimen/icon_size_large"
                                android:layout_gravity="top|end"
                                android:layout_margin="4dp"
                                android:background="?attr/glassCardBackgroundCustom"
                                android:contentDescription="@string/action_retake"
                                android:elevation="2dp"
                                android:padding="4dp"
                                android:src="@drawable/ic_retake"
                                android:tint="?attr/textPrimaryCustom"
                                android:visibility="gone" />

                            <ImageButton
                                android:id="@+id/btn_delete_left"
                                android:layout_width="@dimen/icon_size_large"
                                android:layout_height="@dimen/icon_size_large"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="4dp"
                                android:layout_marginBottom="44dp"
                                android:background="?attr/glassCardBackgroundCustom"
                                android:contentDescription="@string/action_delete"
                                android:elevation="2dp"
                                android:padding="4dp"
                                android:src="@drawable/ic_delete"
                                android:tint="?attr/textPrimaryCustom"
                                android:visibility="gone" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/container_right"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="@dimen/grid_item_margin"
                            android:layout_rowWeight="1"
                            android:background="?attr/glassCardBackgroundCustom"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="6dp">

                            <ImageView
                                android:id="@+id/iv_right"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/cd_photo_right"
                                android:scaleType="fitCenter"
                                android:src="@drawable/right" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_gravity="bottom"
                                android:background="?attr/photoOverlayCustom" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|center_horizontal"
                                android:layout_marginBottom="8dp"
                                android:fontFamily="sans-serif-black"
                                android:text="@string/photo_label_right"
                                android:textColor="?attr/textPrimaryCustom"
                                android:textSize="@dimen/text_size_caption"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/btn_retake_right"
                                android:layout_width="@dimen/icon_size_large"
                                android:layout_height="@dimen/icon_size_large"
                                android:layout_gravity="top|end"
                                android:layout_margin="4dp"
                                android:background="?attr/glassCardBackgroundCustom"
                                android:contentDescription="@string/action_retake"
                                android:elevation="2dp"
                                android:padding="4dp"
                                android:src="@drawable/ic_retake"
                                android:tint="?attr/textPrimaryCustom"
                                android:visibility="gone" />

                            <ImageButton
                                android:id="@+id/btn_delete_right"
                                android:layout_width="@dimen/icon_size_large"
                                android:layout_height="@dimen/icon_size_large"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="4dp"
                                android:layout_marginBottom="44dp"
                                android:background="?attr/glassCardBackgroundCustom"
                                android:contentDescription="@string/action_delete"
                                android:elevation="2dp"
                                android:padding="4dp"
                                android:src="@drawable/ic_delete"
                                android:tint="?attr/textPrimaryCustom"
                                android:visibility="gone" />
                        </FrameLayout>
                    </GridLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_entry"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/primary_button_height"
                android:layout_marginTop="@dimen/spacing_xxlarge"
                android:layout_marginBottom="@dimen/spacing_large"
                android:text="@string/action_confirm_entry"
                android:textAllCaps="false"
                android:textSize="@dimen/text_size_button"
                android:textStyle="bold"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="@dimen/button_corner_radius_full"
                app:layout_constraintTop_toBottomOf="@id/container_bodywork_data" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_nav_height"
            android:background="?attr/homeSurfaceBackground"
            app:elevation="@dimen/elevation_none"
            app:itemIconTint="?attr/bottomNavItemColorCustom"
            app:itemBackground="@drawable/bg_bottom_nav_item"
            app:labelVisibilityMode="unlabeled"
            app:menu="@menu/home_bottom_menu" />

        <View
            android:id="@+id/bottom_nav_indicator"
            android:layout_width="@dimen/bottom_nav_indicator_width"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_bottom_nav_indicator"
            android:backgroundTint="?attr/bottomNavItemColorCustom"
            android:visibility="invisible" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
