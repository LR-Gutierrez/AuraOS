<?xml version="1.0" encoding="utf-8"?>
<!-- Cash movement: time · plate over type · amount. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View style="@style/Widget.Pc.Hairline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textAppearance="@style/TextAppearance.Pc.Mono"
            tools:text="10:24 a. m." />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_plate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/aura_mono"
                android:letterSpacing="0.04"
                android:textColor="?attr/textPrimaryCustom"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="AB123CD" />

            <TextView
                android:id="@+id/tv_kind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Pc.Hint"
                tools:text="Auto · 2 h 14 min" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/aura_mono"
            android:textColor="?attr/textPrimaryCustom"
            android:textSize="13sp"
            tools:text="$4.50" />
    </LinearLayout>
</LinearLayout>
