<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/homeSurfaceBackground"
    tools:context=".ui.branches.BranchFormActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="@dimen/elevation_none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_header_height"
            android:background="?attr/navbarBackground"
            android:paddingHorizontal="@dimen/spacing_large"
            app:layout_scrollFlags="scroll|enterAlways">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:background="?attr/glassCardBackgroundCustom"
                android:contentDescription="@string/action_back"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="?attr/textPrimaryCustom"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:fontFamily="sans-serif-black"
                android:text="Nueva sucursal"
                android:textColor="?attr/textPrimaryCustom"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btn_back"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="true"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/container_padding"
            android:paddingTop="@dimen/spacing_large"
            android:paddingBottom="@dimen/spacing_xxlarge">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_basic_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardBackgroundColor="?attr/cardGlassFillColorCustom"
                app:strokeColor="?attr/dividerColorCustom"
                app:strokeWidth="@dimen/stroke_thin"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:id="@+id/lbl_section_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/branch_section_general"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_overline"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/et_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:background="?attr/hollowInputBackground"
                        android:fontFamily="sans-serif"
                        android:hint="@string/branch_hint_name"
                        android:imeOptions="actionNext"
                        android:inputType="text|textCapWords"
                        android:maxLines="1"
                        android:padding="@dimen/spacing_medium"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textColorHint="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintTop_toBottomOf="@id/lbl_section_info"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <EditText
                        android:id="@+id/et_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:background="?attr/hollowInputBackground"
                        android:fontFamily="sans-serif"
                        android:hint="@string/branch_hint_address"
                        android:imeOptions="actionNext"
                        android:inputType="text|textCapWords"
                        android:maxLines="2"
                        android:padding="@dimen/spacing_medium"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textColorHint="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintTop_toBottomOf="@id/et_name"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_capacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardBackgroundColor="?attr/cardGlassFillColorCustom"
                app:strokeColor="?attr/dividerColorCustom"
                app:strokeWidth="@dimen/stroke_thin"
                app:layout_constraintTop_toBottomOf="@id/card_basic_info">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:id="@+id/lbl_section_capacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/branch_section_capacity"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_overline"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/et_moto_capacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:background="?attr/hollowInputBackground"
                        android:fontFamily="sans-serif"
                        android:hint="@string/branch_hint_moto_capacity"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLines="1"
                        android:padding="@dimen/spacing_medium"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textColorHint="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintTop_toBottomOf="@id/lbl_section_capacity"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <EditText
                        android:id="@+id/et_light_capacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:background="?attr/hollowInputBackground"
                        android:fontFamily="sans-serif"
                        android:hint="@string/branch_hint_light_capacity"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLines="1"
                        android:padding="@dimen/spacing_medium"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textColorHint="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintTop_toBottomOf="@id/et_moto_capacity"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <EditText
                        android:id="@+id/et_heavy_capacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:background="?attr/hollowInputBackground"
                        android:fontFamily="sans-serif"
                        android:hint="@string/branch_hint_heavy_capacity"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLines="1"
                        android:padding="@dimen/spacing_medium"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textColorHint="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintTop_toBottomOf="@id/et_light_capacity"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_rates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardBackgroundColor="?attr/cardGlassFillColorCustom"
                app:strokeColor="?attr/dividerColorCustom"
                app:strokeWidth="@dimen/stroke_thin"
                app:layout_constraintTop_toBottomOf="@id/card_capacity">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:id="@+id/lbl_section_rates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/branch_section_rates"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_overline"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/et_moto_rate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:background="?attr/hollowInputBackground"
                        android:fontFamily="sans-serif"
                        android:hint="@string/branch_hint_moto_rate"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:padding="@dimen/spacing_medium"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textColorHint="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintTop_toBottomOf="@id/lbl_section_rates"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <EditText
                        android:id="@+id/et_light_rate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:background="?attr/hollowInputBackground"
                        android:fontFamily="sans-serif"
                        android:hint="@string/branch_hint_light_rate"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:padding="@dimen/spacing_medium"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textColorHint="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintTop_toBottomOf="@id/et_moto_rate"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <EditText
                        android:id="@+id/et_heavy_rate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:background="?attr/hollowInputBackground"
                        android:fontFamily="sans-serif"
                        android:hint="@string/branch_hint_heavy_rate"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:padding="@dimen/spacing_medium"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textColorHint="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintTop_toBottomOf="@id/et_light_rate"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_overnight_rates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardBackgroundColor="?attr/cardGlassFillColorCustom"
                app:strokeColor="?attr/dividerColorCustom"
                app:strokeWidth="@dimen/stroke_thin"
                app:layout_constraintTop_toBottomOf="@id/card_rates">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:id="@+id/lbl_section_overnight_rates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/branch_section_overnight_rates"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_overline"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/et_moto_overnight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:background="?attr/hollowInputBackground"
                        android:fontFamily="sans-serif"
                        android:hint="@string/branch_hint_moto_overnight"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:padding="@dimen/spacing_medium"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textColorHint="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintTop_toBottomOf="@id/lbl_section_overnight_rates"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <EditText
                        android:id="@+id/et_light_overnight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:background="?attr/hollowInputBackground"
                        android:fontFamily="sans-serif"
                        android:hint="@string/branch_hint_light_overnight"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:padding="@dimen/spacing_medium"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textColorHint="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintTop_toBottomOf="@id/et_moto_overnight"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <EditText
                        android:id="@+id/et_heavy_overnight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:background="?attr/hollowInputBackground"
                        android:fontFamily="sans-serif"
                        android:hint="@string/branch_hint_heavy_overnight"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:padding="@dimen/spacing_medium"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textColorHint="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintTop_toBottomOf="@id/et_light_overnight"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_hours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardBackgroundColor="?attr/cardGlassFillColorCustom"
                app:strokeColor="?attr/dividerColorCustom"
                app:strokeWidth="@dimen/stroke_thin"
                app:layout_constraintTop_toBottomOf="@id/card_overnight_rates">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:id="@+id/lbl_section_hours"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/branch_section_hours"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_overline"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/et_open_weekday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:background="?attr/hollowInputBackground"
                        android:fontFamily="sans-serif"
                        android:hint="@string/branch_hint_open_weekday"
                        android:imeOptions="actionNext"
                        android:inputType="time"
                        android:maxLines="1"
                        android:padding="@dimen/spacing_medium"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textColorHint="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintTop_toBottomOf="@id/lbl_section_hours"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <EditText
                        android:id="@+id/et_close_weekday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:background="?attr/hollowInputBackground"
                        android:fontFamily="sans-serif"
                        android:hint="@string/branch_hint_close_weekday"
                        android:imeOptions="actionNext"
                        android:inputType="time"
                        android:maxLines="1"
                        android:padding="@dimen/spacing_medium"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textColorHint="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintTop_toBottomOf="@id/et_open_weekday"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <EditText
                        android:id="@+id/et_open_weekend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:background="?attr/hollowInputBackground"
                        android:fontFamily="sans-serif"
                        android:hint="@string/branch_hint_open_weekend"
                        android:imeOptions="actionNext"
                        android:inputType="time"
                        android:maxLines="1"
                        android:padding="@dimen/spacing_medium"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textColorHint="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintTop_toBottomOf="@id/et_close_weekday"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <EditText
                        android:id="@+id/et_close_weekend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:background="?attr/hollowInputBackground"
                        android:fontFamily="sans-serif"
                        android:hint="@string/branch_hint_close_weekend"
                        android:imeOptions="actionDone"
                        android:inputType="time"
                        android:maxLines="1"
                        android:padding="@dimen/spacing_medium"
                        android:textColor="?attr/textPrimaryCustom"
                        android:textColorHint="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_body"
                        app:layout_constraintTop_toBottomOf="@id/et_open_weekend"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_currency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardBackgroundColor="?attr/cardGlassFillColorCustom"
                app:strokeColor="?attr/dividerColorCustom"
                app:strokeWidth="@dimen/stroke_thin"
                app:layout_constraintTop_toBottomOf="@id/card_hours">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:id="@+id/lbl_section_currency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/branch_section_currency"
                        android:textColor="?attr/textSecondaryCustom"
                        android:textSize="@dimen/text_size_overline"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <Spinner
                        android:id="@+id/spinner_currency"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="@dimen/spacing_medium"
                        app:layout_constraintTop_toBottomOf="@id/lbl_section_currency"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/primary_button_height"
                android:layout_marginTop="@dimen/spacing_xxlarge"
                android:text="@string/branch_save_action"
                android:textAllCaps="false"
                android:textSize="@dimen/text_size_button"
                android:textStyle="bold"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="@dimen/button_corner_radius_full"
                app:layout_constraintTop_toBottomOf="@id/card_currency" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="?attr/colorPrimary"
            app:indicatorSize="48dp"
            app:trackThickness="4dp" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
