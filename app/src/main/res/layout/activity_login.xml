<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/homeSurfaceBackground"
    tools:context=".ui.login.LoginActivity">

    <ImageView
        android:id="@+id/loginBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/loginBackgroundCustom" />

    <LinearLayout
        android:id="@+id/brandingContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xlarge"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="@dimen/login_logo_size"
            android:layout_height="@dimen/login_logo_size"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:background="?attr/glassCardBackgroundCustom"
            android:padding="@dimen/spacing_medium">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_logo"
                android:src="?attr/appLogoCustom" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.03"
            android:text="@string/app_name"
            android:textColor="?attr/textPrimaryCustom"
            android:textSize="@dimen/text_size_display"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:letterSpacing="0.06"
            android:text="@string/app_edition"
            android:textColor="?attr/textSecondaryCustom"
            android:textSize="@dimen/text_size_overline"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/formCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/container_padding"
        android:layout_marginEnd="@dimen/container_padding"
        android:background="?attr/glassCardBackgroundCustom"
        android:orientation="vertical"
        android:paddingStart="@dimen/container_padding"
        android:paddingTop="28dp"
        android:paddingEnd="@dimen/container_padding"
        android:paddingBottom="@dimen/container_padding"
        app:layout_constraintBottom_toTopOf="@+id/footerContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/brandingContainer"
        app:layout_constraintVertical_bias="0.35">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="-0.01"
            android:text="@string/title_authentication"
            android:textColor="?attr/textPrimaryCustom"
            android:textSize="@dimen/text_size_headline"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xsmall"
            android:layout_marginTop="@dimen/spacing_medium_plus"
            android:fontFamily="sans-serif-medium"
            android:text="@string/username"
            android:textColor="?attr/textSecondaryCustom"
            android:textSize="@dimen/text_size_small" />

        <EditText
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="@dimen/login_input_height"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:autofillHints="username"
            android:background="?attr/hollowInputBackground"
            android:hint="@string/prompt_email"
            android:inputType="textEmailAddress"
            android:paddingStart="@dimen/spacing_medium_plus"
            android:paddingEnd="@dimen/spacing_medium_plus"
            android:selectAllOnFocus="true"
            android:textColor="?attr/textPrimaryCustom"
            android:textColorHint="?attr/textSecondaryCustom"
            android:textSize="@dimen/text_size_body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xsmall"
            android:layout_marginTop="@dimen/spacing_small_plus"
            android:fontFamily="sans-serif-medium"
            android:text="@string/pin_password"
            android:textColor="?attr/textSecondaryCustom"
            android:textSize="@dimen/text_size_small" />

        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="@dimen/login_input_height"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:autofillHints="password"
            android:background="?attr/hollowInputBackground"
            android:hint="@string/prompt_password"
            android:imeActionLabel="@string/action_sign_in_short"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:paddingStart="@dimen/spacing_medium_plus"
            android:paddingEnd="@dimen/spacing_medium_plus"
            android:selectAllOnFocus="true"
            android:textColor="?attr/textPrimaryCustom"
            android:textColorHint="?attr/textSecondaryCustom"
            android:textSize="@dimen/text_size_body" />

        <Button
            android:id="@+id/login"
            android:layout_width="match_parent"
            android:layout_height="@dimen/login_button_height"
            android:layout_marginTop="@dimen/spacing_medium_plus"
            android:background="?attr/primaryButtonBackground"
            android:enabled="false"
            android:text="@string/action_sign_in"
            android:textAllCaps="false"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/text_size_button"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <LinearLayout
            android:id="@+id/biometricDivider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium_plus"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="?attr/dividerColorCustom" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small_plus"
                android:layout_marginEnd="@dimen/spacing_small_plus"
                android:fontFamily="sans-serif"
                android:text="@string/label_or_continue_with"
                android:textColor="?attr/textSecondaryCustom"
                android:textSize="@dimen/text_size_caption" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="?attr/dividerColorCustom" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/biometricContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/spacing_medium"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/biometricLogin"
                android:layout_width="@dimen/login_biometric_button_size"
                android:layout_height="@dimen/login_biometric_button_size"
                android:background="?attr/glassCardBackgroundCustom"
                android:contentDescription="@string/biometric_login_icon"
                android:scaleType="centerInside"
                android:src="@drawable/baseline_fingerprint_24"
                app:tint="?attr/textPrimaryCustom" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/quick_access"
                android:textColor="?attr/textSecondaryCustom"
                android:textSize="@dimen/text_size_overline" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/footerContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/container_padding"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_medium"
                android:text="@string/help"
                android:textColor="?attr/textSecondaryCustom"
                android:textSize="@dimen/text_size_small" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_medium"
                android:text="@string/privacy"
                android:textColor="?attr/textSecondaryCustom"
                android:textSize="@dimen/text_size_small" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_status"
                android:textColor="?attr/textSecondaryCustom"
                android:textSize="@dimen/text_size_small" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
