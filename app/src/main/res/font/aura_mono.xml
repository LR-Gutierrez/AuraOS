<?xml version="1.0" encoding="utf-8"?>
<!-- Geist Mono (variable): labels, codes, plates and meta text, as in BCV Tracker. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/geist_mono"
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400"
        app:font="@font/geist_mono"
        app:fontStyle="normal"
        app:fontWeight="400"
        app:fontVariationSettings="'wght' 400" />
    <font
        android:font="@font/geist_mono"
        android:fontStyle="normal"
        android:fontWeight="700"
        android:fontVariationSettings="'wght' 500"
        app:font="@font/geist_mono"
        app:fontStyle="normal"
        app:fontWeight="700"
        app:fontVariationSettings="'wght' 500" />
</font-family>
