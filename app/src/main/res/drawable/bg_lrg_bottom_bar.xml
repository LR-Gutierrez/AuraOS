<?xml version="1.0" encoding="utf-8"?>
<!-- Tab bar: surface with a hairline divider on top (BCV Tracker). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/branchSurfaceCustom" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/dividerColorCustom" />
        </shape>
    </item>
</layer-list>
