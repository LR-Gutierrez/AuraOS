<?xml version="1.0" encoding="utf-8"?>
<!-- BcvSwitch track: 44x26 pill; amber fill + border when on, control border when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="26dp" />
            <corners android:radius="13dp" />
            <solid android:color="?attr/accentCustom" />
            <stroke android:width="1dp" android:color="?attr/accentCustom" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="26dp" />
            <corners android:radius="13dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="?attr/borderControlCustom" />
        </shape>
    </item>
</selector>
