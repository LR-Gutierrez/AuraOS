<?xml version="1.0" encoding="utf-8"?>
<!-- Top bar: page background with a hairline divider underneath. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/homeSurfaceBackground" />
        </shape>
    </item>
    <item
        android:gravity="bottom"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/dividerColorCustom" />
        </shape>
    </item>
</layer-list>
