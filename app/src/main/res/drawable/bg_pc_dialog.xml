<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog window: surface card with hairline and 12dp corners, inset from the screen edges. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="20dp">
    <shape android:shape="rectangle">
        <solid android:color="?attr/branchSurfaceCustom" />
        <stroke android:width="1dp" android:color="?attr/dividerColorCustom" />
        <corners android:radius="12dp" />
    </shape>
</inset>
